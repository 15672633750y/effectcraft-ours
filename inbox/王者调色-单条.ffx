{
  "name": "王者调色（单条三条彩）",
  "note": "一条三条彩(数量1.0)即是 AE 整条链的拟合结果；暗角用 S_Vignette 自行调",
  "effects": [
    {
      "effect": "S_VintageColor3Strip",
      "params": {
        "amount": 1.0,
        "contrast": 1.0
      }
    },
    {
      "effect": "ec.blur.sharpen",
      "params": {
        "amount": 12.0
      }
    },
    {
      "effect": "ec.color.huesaturation",
      "params": {
        "channelControl": 0,
        "hue": 0.0,
        "saturation": -5.0,
        "lightness": 0.0
      }
    }
  ]
}